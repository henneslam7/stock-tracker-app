rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false; // Catch-all default deny
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().keys().hasAll(['email', 'isSubscribed', 'createdAt'])
        && incoming().keys().size() <= 5
        && incoming().email is string && incoming().email.size() <= 200 && incoming().email == request.auth.token.email
        && incoming().isSubscribed is bool
        && incoming().createdAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['isSubscribed', 'updatedAt', 'displayName'])
        && incoming().isSubscribed is bool
        && incoming().updatedAt == request.time;

      allow delete: if false;

      match /portfolio/{symbol} {
         allow get: if isOwner(userId) && isValidId(symbol);
         allow list: if isOwner(userId);

         allow create: if isOwner(userId)
            && isValidId(symbol)
            && incoming().keys().hasAll(['symbol', 'shares', 'averagePrice', 'totalCost', 'updatedAt'])
            && incoming().keys().size() == 5
            && incoming().symbol is string && incoming().symbol.size() <= 20
            && incoming().shares is number && incoming().shares >= 0
            && incoming().averagePrice is number && incoming().averagePrice >= 0
            && incoming().totalCost is number && incoming().totalCost >= 0
            && incoming().updatedAt == request.time;

         allow update: if isOwner(userId)
            && isValidId(symbol)
            && incoming().diff(existing()).affectedKeys().hasOnly(['symbol', 'shares', 'averagePrice', 'totalCost', 'updatedAt'])
            && (incoming().diff(existing()).affectedKeys().hasAny(['symbol']) == false || incoming().symbol == existing().symbol)
            && incoming().shares is number && incoming().shares >= 0
            && incoming().averagePrice is number && incoming().averagePrice >= 0
            && incoming().totalCost is number && incoming().totalCost >= 0
            && incoming().updatedAt == request.time;

         allow delete: if isOwner(userId) && isValidId(symbol);
      }

      match /watchlist/{symbol} {
         allow get: if isOwner(userId) && isValidId(symbol);
         allow list: if isOwner(userId);

         allow create: if isOwner(userId)
            && isValidId(symbol)
            && incoming().keys().hasAll(['symbol', 'addedAt'])
            && incoming().keys().size() == 2
            && incoming().symbol is string && incoming().symbol.size() <= 20
            && incoming().addedAt == request.time;

         allow delete: if isOwner(userId) && isValidId(symbol);
      }
    }
  }
}
